  "merge": {
    "--d-border-radius-fixed": {
      "to": "--d-sys-border-radius-md",
      "note": "Fixed 4px becomes md and follows the theme."
    },
    "--token-radius-normal": {
      "to": "--d-sys-border-radius-md",
      "note": "Fixed 4px becomes md and follows the theme."
    },
    "--token-radius-large": {
      "to": "--d-sys-border-radius-lg",
      "note": "Fixed 8px becomes lg (double md) and follows the theme."
    },
    "--token-radius-small": {
      "to": "--d-sys-border-radius-sm",
      "note": "Fixed 2px becomes sm (half md) and follows the theme."
    },
    "--d-border-radius-pill": {
      "to": "--d-sys-border-radius-full",
      "note": "1em becomes 9999px: differs only on elements taller than 2em."
    },
    "--token-color-background-accent-subtler": {
      "to": "--d-sys-color-background-accent-subtle",
      "note": "tertiary-400, 74%: falls in the subtle band."
    },
    "--tertiary-very-low": {
      "to": "--d-sys-color-background-accent-subtlest",
      "note": "90%, subtlest band."
    },
    "--tertiary-low": {
      "to": "--d-sys-color-background-accent-subtlest",
      "note": "85%, subtlest band; info backgrounds also use it (info-subtlest)."
    },
    "--tertiary-medium": {
      "to": "--d-sys-color-background-accent-subtle",
      "note": "50%; matches the subtle token in light mode only."
    },
    "--tertiary-high": {
      "to": "--d-sys-color-background-accent",
      "note": "20%, base band."
    },
    "--success-low": {
      "to": "--d-sys-color-background-success-subtlest",
      "note": "80%, subtlest band."
    },
    "--input-border-color": {
      "to": "--d-sys-color-border-input",
      "note": "primary-400 vs --token-color-border-input primary-300."
    },
    "--metadata-color": {
      "to": "--d-sys-color-text-muted",
      "note": "Meta text is muted (settled rule); value moves from primary-medium."
    },
    "--title-color": {
      "to": "--d-sys-color-text-default",
      "note": "var(--primary), while --d-sys-color-text-default comes from --token-color-text-default (var(--primary-900)); 1 use."
    },
    "--excerpt-color": {
      "to": "--d-sys-color-text-muted",
      "note": "primary-high vs muted's primary-800."
    },
    "--shadow-composer": {
      "to": "--d-sys-shadow-dialog",
      "note": "0 -1px 40px vs modal's 0 8px 60px."
    },
    "--shadow-docked-composer": {
      "to": "--d-sys-shadow-overflow",
      "note": "Defined in core, used only by the AI plugin."
    }
  },
  "rgb": {
    "--primary-rgb": "--primary",
    "--primary-low-rgb": "--primary-low",
    "--primary-very-low-rgb": "--primary-very-low",
    "--secondary-rgb": "--secondary",
    "--header_background-rgb": "--header_background",
    "--tertiary-rgb": "--tertiary",
    "--highlight-rgb": {
      "to": "--highlight",
      "note": "No reads in core."
    },
    "--success-rgb": {
      "to": "--success",
      "note": "No reads in core."
    }
  }
