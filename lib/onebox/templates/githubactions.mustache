<div class="github-row">
  <div class="github-info-container">
    <h4>
      <a href="{{link}}" target="_blank" rel="noopener">{{title}}</a>
    </h4>

    {{#run_number}}
      <div class="github-info">
        {{name}} <span class="github-run-number">#{{run_number}}</span>
      </div>
    {{/run_number}}
  </div>
</div>
