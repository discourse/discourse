{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "noEmit": true,
    "noEmitOnError": false,
    "declaration": true,
    "outDir": "declarations",
    "composite": true,
    "typeRoots": ["./external-types"],
    "types": [
      "discourse-i18n",
      "ember-modifier",
      "ember-qunit",
      "ember-source",
      "ember-truth-helpers",
      "ember__render-modifiers",
      "ember__string",
      "ember__test-helpers",
      "floating-ui__dom",
      "glimmer__component",
      "glimmer__syntax",
      "glint__template",
      "jquery",
      "pretender",
      "qunit",
      "rsvp",
      "sinon"
    ]
  },
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [".gts", ".gjs"]
    }
  ]
}
