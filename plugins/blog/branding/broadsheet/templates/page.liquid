<article class="broadsheet__article">
  <header class="broadsheet__article-header">
    <p class="broadsheet__kicker">{{ site.title }}</p>
    <h1>{{ article.title }}</h1>
    {% if article.standfirst %}<p class="broadsheet__standfirst">{{ article.standfirst }}</p>{% endif %}
  </header>
  {% if article.cover_url %}<figure class="broadsheet__article-cover"><img src="{{ article.cover_url }}" alt="{{ article.cover_alt }}"{% if article.cover_width %} width="{{ article.cover_width }}" height="{{ article.cover_height }}"{% endif %}></figure>{% endif %}
  <div class="blog-article__body cooked">{{ article.body_html }}</div>
</article>
