<div class="broadsheet">
  <header class="broadsheet__header">
    <a class="broadsheet__brand" href="{{ site.url }}">{{ site.title }}</a>
    <nav class="broadsheet__nav" aria-label="{{ labels.navigation }}">
      <a href="{{ site.url }}">{{ labels.home }}</a>
      <a href="{{ site.about_url }}">{{ labels.about }}</a>
      <a href="{{ site.archive_url }}">{{ labels.archive }}</a>
      <a href="{{ site.feed_url }}">{{ labels.rss }}</a>
    </nav>
    <a class="broadsheet__join" href="{{ site.community_url }}">{{ labels.join_community }} ↗</a>
  </header>
  <main id="main" class="broadsheet__main">{{ content_html }}</main>
  <footer class="broadsheet__footer">
    <div class="broadsheet__footer-brand">
      <a class="broadsheet__brand" href="{{ site.url }}">{{ site.title }}</a>
      <p>{{ labels.footer }}</p>
    </div>
    <nav class="broadsheet__nav" aria-label="{{ labels.navigation }}">
      <a href="{{ site.about_url }}">{{ labels.about }}</a>
      <a href="{{ site.archive_url }}">{{ labels.archive }}</a>
      <a href="{{ site.feed_url }}">{{ labels.rss }}</a>
      <a href="{{ site.editor_url }}">{{ labels.editor }}</a>
    </nav>
  </footer>
</div>
