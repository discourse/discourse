<header class="broadsheet__masthead">
  <p class="broadsheet__kicker">{{ page.eyebrow }}</p>
  <h1>{{ page.heading }}</h1>
  {% if site.description != blank %}<p class="broadsheet__tagline">{{ site.description }}</p>{% endif %}
</header>
<div class="broadsheet__listing">
  <div class="broadsheet__toolbar">
    <h2 class="broadsheet__section-label">{{ labels.latest_stories }}</h2>
    <form class="broadsheet__search" action="{{ site.archive_url }}" method="get" role="search">
      {% if page.preview_token %}<input type="hidden" name="blog_theme_preview" value="{{ page.preview_token }}">{% endif %}
      <input type="search" name="q" value="{{ page.query }}" maxlength="100" aria-label="{{ labels.search }}" placeholder="{{ labels.search_placeholder }}">
      <button type="submit" aria-label="{{ labels.search }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="6"></circle><path d="m15 15 6 6"></path></svg></button>
    </form>
  </div>
  <div class="broadsheet__grid">
    {% for article in articles %}
    <article class="broadsheet__story{% if forloop.first %} --lead{% endif %}">
      {% if article.image_url %}
      <a class="broadsheet__cover" href="{{ article.url }}" tabindex="-1" aria-hidden="true"><img src="{{ article.image_url }}" alt="" {% unless forloop.first %}loading="lazy"{% endunless %}></a>
      {% elsif forloop.first %}
      <a class="broadsheet__art" href="{{ article.url }}" tabindex="-1" aria-hidden="true"><span class="broadsheet__art-index">{{ article.index }}</span><span class="broadsheet__art-title">{{ article.title }}</span><span class="broadsheet__art-brand">{{ site.title }}</span></a>
      {% endif %}
      <div class="broadsheet__story-content">
        <p class="broadsheet__kicker">{% unless forloop.first %}<span class="broadsheet__index">{{ article.index }}</span>{% endunless %}{% if article.featured %}{{ labels.featured }}{% else %}{{ article.reading_time }}{% endif %}</p>
        <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <p class="broadsheet__excerpt">{{ article.excerpt }}</p>
        <div class="broadsheet__byline">
          <span><strong>{{ article.author }}</strong></span>
          <time datetime="{{ article.published_at }}">{{ article.date }}</time>
          <a href="{{ article.url }}#discussion">{{ article.replies_label }}</a>
        </div>
      </div>
    </article>
    {% else %}<section class="broadsheet__empty"><h2>{{ labels.empty_title }}</h2><p>{{ labels.empty_body }}</p></section>{% endfor %}
  </div>
  <nav class="blog__pagination broadsheet__pagination" aria-label="{{ labels.pagination }}">
    {% if page.previous_url %}<a rel="prev" href="{{ page.previous_url }}">← {{ labels.newer }}</a>{% endif %}
    {% if page.next_url %}<a rel="next" href="{{ page.next_url }}">{{ labels.older }} →</a>{% endif %}
  </nav>
</div>
