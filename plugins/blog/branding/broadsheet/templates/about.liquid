<article class="broadsheet__article">
  <header class="broadsheet__article-header">
    <p class="broadsheet__kicker">{{ site.title }}</p>
    <h1>{{ labels.about }}</h1>
    {% if site.description != blank %}<p class="broadsheet__standfirst">{{ site.description }}</p>{% endif %}
  </header>
  <div class="blog-article__body cooked">{{ site.about_html }}</div>
  <p><a class="broadsheet__join" href="{{ site.community_url }}">{{ labels.join_community }} ↗</a></p>
</article>
