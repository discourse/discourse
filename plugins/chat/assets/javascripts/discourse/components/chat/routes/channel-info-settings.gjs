import Component from "@glimmer/component";
import { cached, tracked } from "@glimmer/tracking";
import { concat, fn, hash } from "@ember/helper";
import { action } from "@ember/object";
import { LinkTo } from "@ember/routing";
import { cancel } from "@ember/runloop";
import { service } from "@ember/service";
import Form from "discourse/components/form";
import DTooltip from "discourse/float-kit/components/d-tooltip";
import { ajax } from "discourse/lib/ajax";
import { popupAjaxError } from "discourse/lib/ajax-error";
import discourseDebounce from "discourse/lib/debounce";
import DButton from "discourse/ui-kit/d-button";
import dCategoryBadge from "discourse/ui-kit/helpers/d-category-badge";
import dIcon from "discourse/ui-kit/helpers/d-icon";
import dReplaceEmoji from "discourse/ui-kit/helpers/d-replace-emoji";
import { i18n } from "discourse-i18n";
import ChatModalArchiveChannel from "discourse/plugins/chat/discourse/components/chat/modal/archive-channel";
import ChatModalDeleteChannel from "discourse/plugins/chat/discourse/components/chat/modal/delete-channel";
import ChatModalToggleChannelStatus from "discourse/plugins/chat/discourse/components/chat/modal/toggle-channel-status";
import ChatRetentionReminderText from "discourse/plugins/chat/discourse/components/chat-retention-reminder-text";
import ToggleChannelMembershipButton from "discourse/plugins/chat/discourse/components/toggle-channel-membership-button";
import {
  CHANNEL_NAME_MAX_LENGTH,
  CHANNEL_SLUG_MAX_LENGTH,
} from "discourse/plugins/chat/discourse/lib/chat-constants";
import slugifyChannel from "discourse/plugins/chat/discourse/lib/slugify-channel";

const NOTIFICATION_LEVELS = ["never", "mention", "always"];

export default class ChatRouteChannelInfoSettings extends Component {
  @service chatApi;
  @service chatChannelsManager;
  @service chatGuardian;
  @service dialog;
  @service modal;
  @service router;
  @service site;
  @service siteSettings;
  @service toasts;

  @tracked formApi = null;
  @tracked
  autoGeneratedSlug =
    this.args.channel.slug ?? slugifyChannel(this.args.channel);

  notificationLevels = NOTIFICATION_LEVELS;

  #generateSlugHandler = null;

  willDestroy() {
    super.willDestroy(...arguments);
    cancel(this.#generateSlugHandler);
  }

  // Existing values may predate the limits; let them keep their length.
  get nameValidation() {
    const max = Math.max(
      CHANNEL_NAME_MAX_LENGTH,
      this.args.channel.title?.length ?? 0
    );
    return `length:0,${max}`;
  }

  get slugValidation() {
    const max = Math.max(
      CHANNEL_SLUG_MAX_LENGTH,
      this.args.channel.slug?.length ?? 0
    );
    return `length:0,${max}`;
  }

  get canEditChannel() {
    if (
      this.args.channel.isCategoryChannel &&
      this.chatGuardian.canEditChatChannel()
    ) {
      return true;
    }

    if (
      this.args.channel.isDirectMessageChannel &&
      this.args.channel.chatable.group
    ) {
      return true;
    }

    return false;
  }

  get hasEditableChannelFields() {
    return this.canEditChannel || this.toggleThreadingDirectMessage;
  }

  get shouldRenderAdminFields() {
    return (
      this.canEditChannel &&
      this.args.channel.isCategoryChannel &&
      this.args.channel.isOpen
    );
  }

  get shouldRenderStatusSection() {
    return this.canEditChannel && this.args.channel.isCategoryChannel;
  }

  get shouldRenderArchiveRow() {
    return this.chatGuardian.canArchiveChannel(this.args.channel);
  }

  get shouldRenderNotificationForm() {
    return (
      this.args.channel.isOpen &&
      this.args.channel.currentUserMembership.following
    );
  }

  get canToggleChannelState() {
    return this.args.channel.isClosed;
  }

  get openChannelDisabledReason() {
    if (this.args.channel.isArchived) {
      return i18n("chat.channel_settings.open_channel_disabled_archived");
    }
    return i18n("chat.channel_settings.open_channel_disabled_read_only");
  }

  get toggleThreadingDirectMessage() {
    return this.args.channel.isDirectMessageChannel && this.args.channel.isOpen;
  }

  get autoJoinAvailable() {
    return this.siteSettings.max_chat_auto_joined_users > 0;
  }

  get channelSectionTitle() {
    return this.hasEditableChannelFields
      ? i18n("chat.channel_settings.title")
      : i18n("chat.settings.info_title");
  }

  get shouldRenderDangerZone() {
    return (
      this.shouldRenderStatusSection ||
      this.args.channel.currentUserMembership.following
    );
  }

  @cached
  get channelFormData() {
    const channel = this.args.channel;

    return {
      name: channel.title,
      slug: channel.slug,
      emoji: channel.emoji,
      description: channel.description,
      auto_join_users: channel.autoJoinUsers,
      allow_channel_wide_mentions: channel.allowChannelWideMentions,
      threading_enabled: channel.threadingEnabled,
    };
  }

  @cached
  get notificationFormData() {
    const membership = this.args.channel.currentUserMembership;

    return {
      muted: membership.muted,
      notification_level: membership.notificationLevel,
    };
  }

  @action
  registerChannelFormApi(api) {
    this.formApi = api;
  }

  @action
  onNameChange(name, { set }) {
    set("name", name);
    this.#debouncedGenerateSlug(name);
  }

  @action
  onSlugChange(slug, { set }) {
    set("slug", slug);
    this.#debouncedGenerateSlug(this.formApi.get("name"));
  }

  @action
  onSubmitChannelForm(data) {
    const changes = this.#changedValues(data, this.channelFormData);

    if (!Object.keys(changes).length) {
      return;
    }

    if (changes.auto_join_users) {
      return this.dialog.confirm({
        message: i18n("chat.settings.auto_join_users_warning", {
          category: this.args.channel.chatable.name,
        }),
        didConfirm: () => this.#saveChannel(changes),
        didCancel: () => this.formApi.set("auto_join_users", false),
      });
    }

    return this.#saveChannel(changes);
  }

  @action
  async onNotificationSettingChange(value, { name, set }) {
    const previousValue = this.notificationFormData[name];
    set(name, value);

    try {
      const result =
        await this.chatApi.updateCurrentUserChannelNotificationsSettings(
          this.args.channel.id,
          { [name]: value }
        );

      const membership = this.args.channel.currentUserMembership;
      membership.muted = result.membership.muted;
      membership.notificationLevel = result.membership.notification_level;
      this.toasts.success({ data: { message: i18n("saved") } });
    } catch (error) {
      set(name, previousValue);
      popupAjaxError(error);
    }
  }

  @action
  onToggleChannelState() {
    return this.modal.show(ChatModalToggleChannelStatus, {
      model: this.args.channel,
    });
  }

  @action
  onArchiveChannel() {
    return this.modal.show(ChatModalArchiveChannel, {
      model: { channel: this.args.channel },
    });
  }

  @action
  onDeleteChannel() {
    return this.modal.show(ChatModalDeleteChannel, {
      model: { channel: this.args.channel },
    });
  }

  @action
  onLeaveChannel(channel) {
    this.chatChannelsManager.remove(channel);
    return this.router.transitionTo("chat");
  }

  #changedValues(data, initialData) {
    return Object.fromEntries(
      Object.entries(data).filter(
        ([key, value]) => (value ?? "") !== (initialData[key] ?? "")
      )
    );
  }

  async #saveChannel(changes) {
    const channel = this.args.channel;

    try {
      const result = await this.chatApi.updateChannel(channel.id, changes);

      channel.title = result.channel.title;
      channel.slug = result.channel.slug;
      channel.emoji = result.channel.emoji;
      channel.description = result.channel.description;
      channel.threadingEnabled = result.channel.threading_enabled;

      if (channel.isCategoryChannel) {
        channel.autoJoinUsers = result.channel.auto_join_users;
        channel.allowChannelWideMentions =
          result.channel.allow_channel_wide_mentions;
      }

      this.toasts.success({ data: { message: i18n("saved") } });

      if ("name" in changes || "slug" in changes) {
        this.router.replaceWith(
          "chat.channel.info.settings",
          ...channel.routeModels
        );
      }
    } catch (error) {
      popupAjaxError(error);
    }
  }

  #debouncedGenerateSlug(name) {
    cancel(this.#generateSlugHandler);
    this.autoGeneratedSlug = "";

    if (!name) {
      return;
    }

    this.#generateSlugHandler = discourseDebounce(
      this,
      this.#generateSlug,
      name,
      300
    );
  }

  // The slug is only a placeholder hint; a blank slug is regenerated server-side.
  async #generateSlug(name) {
    try {
      const response = await ajax("/slugs.json", {
        type: "POST",
        data: { name },
      });
      this.autoGeneratedSlug = response.slug;
    } catch {}
  }

  <template>
    <div class="c-routes --channel-info-settings">
      <h1 class="sr-only">{{i18n
          "chat.channel_settings.page_title"
          channel=@channel.title
        }}</h1>

      <div class="c-channel-settings">
        {{#if this.shouldRenderNotificationForm}}
          <Form
            class="c-channel-settings__notification-form"
            @data={{this.notificationFormData}}
            as |form transientData|
          >
            <form.Section>
              <form.Field
                class="--large"
                @name="muted"
                @onSet={{this.onNotificationSettingChange}}
                @showOptional={{false}}
                @title={{i18n "chat.settings.mute"}}
                @type="toggle"
                as |field|
              >
                <field.Control />
              </form.Field>

              {{#unless transientData.muted}}
                <form.Field
                  class="--large"
                  @name="notification_level"
                  @onSet={{this.onNotificationSettingChange}}
                  @showOptional={{false}}
                  @title={{i18n "chat.settings.notification_level"}}
                  @type="select"
                  as |field|
                >
                  <field.Control @includeNone={{false}} as |select|>
                    {{#each this.notificationLevels as |level|}}
                      <select.Option @value={{level}}>
                        {{i18n (concat "chat.notification_levels." level)}}
                      </select.Option>
                    {{/each}}
                  </field.Control>
                </form.Field>
              {{/unless}}
            </form.Section>
          </Form>
        {{/if}}

        <Form
          class="c-channel-settings__channel-form"
          @data={{this.channelFormData}}
          @onRegisterApi={{this.registerChannelFormApi}}
          @onSubmit={{this.onSubmitChannelForm}}
          as |form|
        >
          {{#let
            (if this.hasEditableChannelFields form.Emphasis form.Section)
            as |ChannelSection|
          }}
            <ChannelSection @title={{this.channelSectionTitle}}>
              {{#if this.canEditChannel}}
                <form.Field
                  @format="large"
                  @name="name"
                  @onSet={{this.onNameChange}}
                  @showOptional={{false}}
                  @title={{i18n "chat.channel_edit_name_slug_modal.name"}}
                  @type="input"
                  @validation={{this.nameValidation}}
                  as |field|
                >
                  <field.Control
                    placeholder={{i18n
                      "chat.channel_edit_name_slug_modal.input_placeholder"
                    }}
                  />
                </form.Field>

                <form.Field
                  @format="large"
                  @name="slug"
                  @onSet={{this.onSlugChange}}
                  @showOptional={{false}}
                  @title={{i18n "chat.channel_edit_name_slug_modal.slug"}}
                  @tooltip={{i18n
                    "chat.channel_edit_name_slug_modal.slug_description"
                  }}
                  @type="input"
                  @validation={{this.slugValidation}}
                  as |field|
                >
                  <field.Control placeholder={{this.autoGeneratedSlug}} />
                </form.Field>

                {{#if this.siteSettings.enable_emoji}}
                  <form.Field
                    @name="emoji"
                    @showOptional={{false}}
                    @title={{i18n "chat.channel_edit_name_slug_modal.emoji"}}
                    @type="emoji"
                    as |field|
                  >
                    <field.Control @context="channel-emoji" />

                    {{#if field.value}}
                      <DButton
                        class="btn-flat edit-channel-clear-emoji"
                        @action={{fn field.set null}}
                        @label="chat.channel_edit_name_slug_modal.reset_emoji"
                      />
                    {{/if}}
                  </form.Field>
                {{/if}}

                {{#if @channel.isCategoryChannel}}
                  <form.Field
                    @format="full"
                    @name="description"
                    @showOptional={{false}}
                    @title={{i18n "chat.about_view.description"}}
                    @type="textarea"
                    @validation="length:0,280"
                    as |field|
                  >
                    <field.Control
                      placeholder={{i18n
                        "chat.channel_edit_description_modal.input_placeholder"
                      }}
                    />
                  </form.Field>
                {{/if}}
              {{else}}
                <form.Container @title={{i18n "chat.about_view.name"}}>
                  <div class="c-channel-settings__name">
                    {{dReplaceEmoji @channel.title}}
                  </div>

                  {{#if @channel.isCategoryChannel}}
                    <div class="c-channel-settings__slug">
                      <LinkTo
                        @models={{@channel.routeModels}}
                        @route="chat.channel"
                      >
                        /chat/c/{{@channel.slug}}/{{@channel.id}}
                      </LinkTo>
                    </div>
                  {{/if}}
                </form.Container>

                {{#if @channel.description.length}}
                  <form.Container @title={{i18n "chat.about_view.description"}}>
                    <div class="c-channel-settings__description">
                      {{@channel.description}}
                    </div>
                  </form.Container>
                {{/if}}
              {{/if}}

              {{#if @channel.isCategoryChannel}}
                <form.Container @title={{i18n "chat.settings.category_label"}}>
                  {{dCategoryBadge
                    @channel.chatable
                    link=true
                    allowUncategorized=true
                  }}
                </form.Container>
              {{/if}}

              <form.Container @title={{i18n "chat.settings.history_label"}}>
                <ChatRetentionReminderText
                  @channel={{@channel}}
                  @type="short"
                />
              </form.Container>

              {{#if this.site.mobileView}}
                <form.Container>
                  <LinkTo
                    class="c-channel-settings__members-link"
                    @models={{@channel.routeModels}}
                    @route="chat.channel.info.members"
                  >
                    {{i18n "chat.channel_info.tabs.members"}}
                    {{dIcon "chevron-right"}}
                  </LinkTo>
                </form.Container>
              {{/if}}

              {{#if this.shouldRenderAdminFields}}
                {{#if this.autoJoinAvailable}}
                  <form.Field
                    @name="auto_join_users"
                    @showOptional={{false}}
                    @title={{i18n "chat.settings.auto_join_users_label"}}
                    @type="checkbox"
                    as |field|
                  >
                    <field.Control />
                  </form.Field>
                {{/if}}

                <form.Field
                  @name="allow_channel_wide_mentions"
                  @showOptional={{false}}
                  @title={{i18n "chat.settings.channel_wide_mentions_label"}}
                  @type="checkbox"
                  as |field|
                >
                  <field.Control />
                </form.Field>
              {{/if}}

              {{#if
                (or
                  this.shouldRenderAdminFields this.toggleThreadingDirectMessage
                )
              }}
                <form.Field
                  class="--large"
                  @name="threading_enabled"
                  @showOptional={{false}}
                  @title={{i18n "chat.settings.channel_threading_label"}}
                  @type="checkbox"
                  as |field|
                >
                  <field.Control>
                    {{i18n "chat.settings.channel_threading_description"}}
                  </field.Control>
                </form.Field>
              {{/if}}

              {{#if this.hasEditableChannelFields}}
                <form.Actions>
                  <form.Submit
                    @disabled={{not this.formApi.isDirty}}
                    @label="save"
                  />
                </form.Actions>
              {{/if}}
            </ChannelSection>
          {{/let}}
        </Form>

        <div class="c-channel-settings__actions">
          {{#unless @channel.currentUserMembership.following}}
            <div class="c-channel-settings__join">
              <ToggleChannelMembershipButton
                @channel={{@channel}}
                @onLeave={{this.onLeaveChannel}}
                @options={{hash
                  joinClass="btn-primary"
                  leaveClass="btn-default"
                  joinIcon="right-to-bracket"
                  leaveIcon="right-from-bracket"
                  leaveDestructive=true
                }}
              />
            </div>
          {{/unless}}

          {{#if this.shouldRenderDangerZone}}
            <section class="c-channel-settings__danger-zone">
              <h2 class="c-channel-settings__danger-zone-title">
                {{i18n "chat.channel_settings.danger_zone.title"}}
              </h2>
              <ul class="c-channel-settings__danger-actions">
                {{#if @channel.currentUserMembership.following}}
                  <li class="c-channel-settings__danger-action">
                    <div class="c-channel-settings__danger-action-context">
                      <div class="c-channel-settings__danger-action-title">
                        {{i18n "chat.channel_settings.danger_zone.leave_title"}}
                      </div>
                      <div
                        class="c-channel-settings__danger-action-description"
                      >
                        {{#if @channel.chatable.group}}
                          {{i18n "chat.channel_settings.leave_groupchat_info"}}
                        {{else}}
                          {{i18n
                            "chat.channel_settings.danger_zone.leave_description"
                          }}
                        {{/if}}
                      </div>
                    </div>
                    <div class="c-channel-settings__danger-cta">
                      <ToggleChannelMembershipButton
                        @channel={{@channel}}
                        @onLeave={{this.onLeaveChannel}}
                        @options={{hash
                          leaveClass="btn-default"
                          leaveIcon="right-from-bracket"
                          leaveDestructive=true
                        }}
                      />
                    </div>
                  </li>
                {{/if}}

                {{#if this.shouldRenderArchiveRow}}
                  <li class="c-channel-settings__danger-action">
                    <div class="c-channel-settings__danger-action-context">
                      <div class="c-channel-settings__danger-action-title">
                        {{i18n
                          "chat.channel_settings.danger_zone.archive_title"
                        }}
                      </div>
                      <div
                        class="c-channel-settings__danger-action-description"
                      >
                        {{i18n
                          "chat.channel_settings.danger_zone.archive_description"
                        }}
                      </div>
                    </div>
                    <div class="c-channel-settings__danger-cta">
                      <DButton
                        class="archive-btn btn-default"
                        @action={{this.onArchiveChannel}}
                        @icon="box-archive"
                        @label="chat.channel_settings.archive_channel"
                      />
                    </div>
                  </li>
                {{/if}}

                {{#if this.shouldRenderStatusSection}}
                  {{#if @channel.isOpen}}
                    <li class="c-channel-settings__danger-action">
                      <div class="c-channel-settings__danger-action-context">
                        <div class="c-channel-settings__danger-action-title">
                          {{i18n
                            "chat.channel_settings.danger_zone.close_title"
                          }}
                        </div>
                        <div
                          class="c-channel-settings__danger-action-description"
                        >
                          {{i18n
                            "chat.channel_settings.danger_zone.close_description"
                          }}
                        </div>
                      </div>
                      <div class="c-channel-settings__danger-cta">
                        <DButton
                          class="close-btn btn-default"
                          @action={{this.onToggleChannelState}}
                          @icon="lock"
                          @label="chat.channel_settings.close_channel"
                        />
                      </div>
                    </li>
                  {{else}}
                    <li
                      class="c-channel-settings__danger-action
                        {{unless this.canToggleChannelState '--forbidden'}}"
                    >
                      <div class="c-channel-settings__danger-action-context">
                        <div class="c-channel-settings__danger-action-title">
                          {{i18n
                            "chat.channel_settings.danger_zone.open_title"
                          }}
                        </div>
                        <div
                          class="c-channel-settings__danger-action-description"
                        >
                          {{#if this.canToggleChannelState}}
                            {{i18n
                              "chat.channel_settings.danger_zone.open_description"
                            }}
                          {{else}}
                            {{this.openChannelDisabledReason}}
                          {{/if}}
                        </div>
                      </div>
                      <div class="c-channel-settings__danger-cta">
                        {{#if this.canToggleChannelState}}
                          <DButton
                            class="open-btn btn-default btn-small"
                            @action={{this.onToggleChannelState}}
                            @icon="unlock"
                            @label="chat.channel_settings.open_channel"
                          />
                        {{else}}
                          <DTooltip
                            @identifier="channel-open-disabled"
                            @placement="left"
                          >
                            <:trigger>
                              <DButton
                                class="open-btn btn-default btn-small"
                                @disabled={{true}}
                                @icon="unlock"
                                @label="chat.channel_settings.open_channel"
                              />
                            </:trigger>
                            <:content>
                              {{this.openChannelDisabledReason}}
                            </:content>
                          </DTooltip>
                        {{/if}}
                      </div>
                    </li>
                  {{/if}}

                  <li class="c-channel-settings__danger-action">
                    <div class="c-channel-settings__danger-action-context">
                      <div class="c-channel-settings__danger-action-title">
                        {{i18n
                          "chat.channel_settings.danger_zone.delete_title"
                        }}
                      </div>
                      <div
                        class="c-channel-settings__danger-action-description"
                      >
                        {{i18n
                          "chat.channel_settings.danger_zone.delete_description"
                        }}
                      </div>
                    </div>
                    <div class="c-channel-settings__danger-cta">
                      <DButton
                        class="delete-btn btn-danger"
                        @action={{this.onDeleteChannel}}
                        @icon="trash-can"
                        @label="chat.channel_settings.delete_channel"
                      />
                    </div>
                  </li>
                {{/if}}
              </ul>
            </section>
          {{/if}}

        </div>
      </div>
    </div>
  </template>
}
