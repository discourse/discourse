{
  "tests": {
    "requiredPlugins": [
      "discourse-lazy-videos",
      "spoiler-alert"
    ]
  },
  "frontend": {
    "staticModules": true,
    "sharedModules": [
      "discourse/components/channel-title",
      "discourse/components/chat-channel",
      "discourse/models/chat-channel"
    ],
    "splitAtRoutes": {
      "chat/*": "chat.*",
      "u/*/preferences/chat": "preferences.chat",
      "admin/plugins/chat/hooks/*": "admin-plugins.show.discourse-chat-incoming-webhooks.*"
    }
  }
}
