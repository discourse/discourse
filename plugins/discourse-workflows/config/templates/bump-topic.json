{
  "name": "Bump topic from the admin menu",
  "description": "Adds a button to the topic admin menu that immediately bumps the topic to the top of the latest list.",
  "nodes": [
    {
      "id": "bump-button",
      "type": "trigger:topic_admin_button",
      "typeVersion": "1.0",
      "name": "Bump button",
      "parameters": {
        "label": "Bump topic",
        "icon": "arrow-up"
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "bump-topic",
      "type": "action:topic",
      "typeVersion": "1.0",
      "name": "Bump topic",
      "parameters": {
        "operation": "bump",
        "topic_id": "={{ $json.topic.id }}",
        "silent": false,
        "actor_username": "system"
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 240,
        "y": 0
      }
    },
    {
      "id": "note-button",
      "type": "flow:sticky_note",
      "typeVersion": "1.0",
      "name": "Sticky Note",
      "parameters": {
        "content": "Double-click \"Bump button\" to change the label and icon of the button added to the topic admin menu.",
        "width": 220,
        "height": 250,
        "color": "green"
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": -20,
        "y": -110
      }
    },
    {
      "id": "note-bump",
      "type": "flow:sticky_note",
      "typeVersion": "1.0",
      "name": "Sticky Note",
      "parameters": {
        "content": "\"Bump topic\" moves the topic to the top of the latest list. Double-click it to bump silently, without adding a visible entry to the topic.",
        "width": 220,
        "height": 250,
        "color": "blue"
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 220,
        "y": -110
      }
    }
  ],
  "connections": {
    "Bump button": {
      "main": [
        [
          {
            "node": "Bump topic",
            "type": "main",
            "index": 0
          }
        ]
      ]
