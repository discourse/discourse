{
  "extends": "discourse/tsconfig-plugin",
  "include": [
    "admin/assets/javascripts/**/*",
    "assets/javascripts/**/*",
    "test/javascripts/**/*"
  ],
  "compilerOptions": {
    "paths": {
      "discourse/plugins/discourse-adplugin/*": [
        "./assets/javascripts/*",
        "./assets/javascripts/*.gjs",
        "./assets/javascripts/*.gts",
        "./admin/assets/javascripts/*",
        "./admin/assets/javascripts/*.gjs",
        "./admin/assets/javascripts/*.gts",
        "./test/javascripts/*",
        "./test/javascripts/*.gjs",
        "./test/javascripts/*.gts"
      ],
      "discourse/plugins/discourse-adplugin/admin/*": [
        "./admin/assets/javascripts/admin/*",
        "./admin/assets/javascripts/admin/*.gjs",
        "./admin/assets/javascripts/admin/*.gts"
      ]
    }
  }
}
