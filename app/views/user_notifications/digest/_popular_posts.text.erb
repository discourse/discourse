<%- if @popular_posts.present? %>
  ### <%=t 'user_notifications.digest.popular_posts' %>

  <%- @popular_posts.each_with_index do |post,i| %>
    <%= post.user.username -%> - <%= raw(@markdown_linker.create(digest_topic_title(post.topic), post.topic.url)) %>

    <%= raw(digest_post_excerpt(post)) %>
  <%- end %>
<%- end %>