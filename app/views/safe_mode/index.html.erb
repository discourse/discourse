<div class="container safe-mode simple-page">
  <h1><%= t "safe_mode.title" %></h1>

  <%= form_tag(safe_mode_enter_path) do %>
    <p><%= t "safe_mode.description" %></p>

    <div class="simple-page__options">
      <label class="simple-page__checkbox checkbox-label">
        <%= check_box_tag "no_themes", true, !flash[:must_select] %>
        <span><%= t "safe_mode.no_themes" %></span>
      </label>
      <label class="simple-page__checkbox checkbox-label">
        <%= check_box_tag "no_unofficial_plugins", true, !flash[:must_select] %>
        <span><%= t "safe_mode.no_unofficial_plugins" %></span>
      </label>
      <label class="simple-page__checkbox checkbox-label">
        <%= check_box_tag "no_plugins", true, !flash[:must_select] %>
        <span><%= t "safe_mode.no_plugins" %></span>
      </label>
    </div>

    <p><%= t "safe_mode.deprecation_error_description" %></p>

    <div class="simple-page__options">
      <label class="simple-page__checkbox checkbox-label">
        <%= check_box_tag "deprecation_errors", true, false %>
        <span><%= t "safe_mode.deprecation_error_label" %></span>
      </label>
    </div>

    <%- if flash[:must_select] %>
      <div class="alert alert-error safe-mode-warning"><%= t "safe_mode.must_select" %></div>
    <%- end %>

    <div class="simple-page__actions">
      <%= submit_tag t("safe_mode.enter"), class: "btn btn-primary", id: "btn-enter-safe-mode" %>
    </div>
  <% end %>
</div>
