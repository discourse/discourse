<% content_for :title do %><%= t("mcp.oauth.page_title", client_name: @client_name, site_name: SiteSetting.title) %><% end %>

<div class="authorize-api-key mcp-consent">
  <h1><%= t("mcp.oauth.authorize_title_html", client_name: tag.bdi(@client_name)) %></h1>

  <div class="authorize-api-key__user">
    <span class="authorize-api-key__user-label"><%= t("mcp.oauth.logged_in_as") %></span>
    <img alt="" class="avatar" height="24" src="<%= current_user.avatar_template_url.gsub("{size}", "48") %>" width="24">
    <span class="authorize-api-key__username"><%= current_user.username %></span>
  </div>

  <% if @client.registration_type == "dcr" %>
    <div class="alert alert-warning mcp-consent__unverified"><%= t("mcp.oauth.unverified_client", client_name: @client_name) %></div>
  <% end %>

  <div class="authorize-api-key__summary">
    <div class="authorize-api-key__permissions">
      <p class="authorize-api-key__permissions-header"><%= t("mcp.oauth.permissions_header_html", client_name: tag.bdi(@client_name)) %></p>
      <% @scope_sections.each do |section| %>
        <% if @scope_sections.size > 1 %>
          <h2 class="mcp-consent__section-title"><%= t("mcp.oauth.scope_sections.#{section.name}") %></h2>
        <% end %>
        <%= render "scopes", items: section.items %>
      <% end %>
    </div>

    <% if @withheld_scopes.present? %>
      <details class="mcp-consent__withheld">
        <summary><%= t("mcp.oauth.withheld_permissions", count: @withheld_scopes.size) %></summary>
        <p><%= t("mcp.oauth.withheld_explanation") %></p>
        <%= render "scopes", items: @withheld_scopes %>
      </details>
    <% end %>

    <div class="authorize-api-key__summary-notice">
      <p><%= t("mcp.oauth.acts_as_you") %></p>
    </div>
  </div>

  <div class="authorize-api-key__redirect">
    <p class="authorize-api-key__redirect-url"><%= mcp_redirect_notice(params[:redirect_uri]) %></p>
  </div>

  <details class="mcp-consent__details">
    <summary><%= t("mcp.oauth.app_details") %></summary>
    <dl>
      <dt><%= t("mcp.oauth.client_id") %></dt>
      <dd><code><%= @client.client_id %></code></dd>
      <dt><%= t("mcp.oauth.redirect_url") %></dt>
      <dd><code><%= params[:redirect_uri] %></code></dd>
      <dt><%= t("mcp.oauth.resource") %></dt>
      <dd><code><%= params[:resource] %></code></dd>
      <dt><%= t("mcp.oauth.scope_ids") %></dt>
      <dd class="mcp-consent__scope-ids">
        <% @granted_scopes.each do |scope| %>
          <code><%= scope %></code>
        <% end %>
      </dd>
    </dl>
  </details>

  <%= form_with url: oauth2_mcp_authorize_path, method: :post do |form| %>
    <% %i[client_id redirect_uri response_type code_challenge code_challenge_method resource scope state].each do |key| %>
      <%= form.hidden_field key, value: params[key] if params[key].present? %>
    <% end %>
    <div class="authorize-api-key__buttons">
      <%= form.button t("mcp.oauth.approve"), name: "decision", value: "approve", class: "btn btn-primary" %>
      <%= form.button t("mcp.oauth.cancel"), name: "decision", value: "deny", class: "btn btn-default" %>
    </div>
  <% end %>

  <p class="mcp-consent__disconnect"><%= t("mcp.oauth.disconnect_html", url: path("/my/preferences/security")) %></p>
</div>
