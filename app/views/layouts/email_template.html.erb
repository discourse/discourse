<% email_theme_renderer =
  local_assigns[:email_theme_renderer] || @email_theme_renderer || Email::ThemeRenderer.new %>
<% email_content = capture do %>
  <%= yield %>
  <% if defined?(html_body) %><%= html_body %><% end %>
<% end %>
<% if @disable_email_custom_styles %>
  <%= email_theme_renderer.html(email_content) %>
<% else %>
  <% preview = defined?(email_preview) ? email_preview : nil %>
  <%= email_html_template(
    preview: preview,
    theme_email_header: email_theme_renderer.html_header,
    theme_email_footer: email_theme_renderer.html_footer,
  ) do %>
    <%= email_content %>
  <% end %>
<% end %>
