<div class="authorize-api-key otp-login">
  <%- if @error %>
    <div class="alert alert-error"><%= @error %></div>
  <%- else %>
    <h1><%= t("user_api_key.otp_confirmation.confirm_title", site_name: SiteSetting.title) %></h1>

    <div class="authorize-api-key__user">
      <img alt="" class="avatar" height="24" src="<%= @otp_user.avatar_template_url.gsub("{size}", "48") %>" width="24">
      <span><%= t("user_api_key.otp_confirmation.logging_in_as", username: @otp_user.username) %></span>
    </div>

    <%= form_tag do %>
      <div class="authorize-api-key__buttons">
        <%= submit_tag(t("user_api_key.otp_confirmation.confirm_button"), class: "btn btn-primary") %>
      </div>
    <% end %>
  <%- end %>
</div>
