#!/usr/bin/env ruby
# frozen_string_literal: true

# Boots without rubygems; the spawning process supplies the gem load paths
# via -I flags. Running this by hand needs those same flags.

base_dir = ARGV[0]

$LOAD_PATH.unshift(File.join(File.expand_path("..", __dir__), "lib"))
require "discourse_vips/worker"

Process.setproctitle("discourse discourse_vips")

# Keep the protocol channel exclusive; stray library output goes to stderr.
protocol = $stdout.dup
$stdout.reopen($stderr)

DiscourseVips::Worker.new(
  exchange_dir: File.join(base_dir, "exchange"),
  scratch_dir: File.join(base_dir, "scratch"),
  output: protocol,
).run
