#!/usr/bin/env ruby
# frozen_string_literal: true

require "rubygems"
require "landlock"
require "msgpack"
require "nokogiri"
require "socket"
require "tmpdir"
require "vips"

raise LoadError, "libvips 8.13 or newer is required" if !Vips.at_least_libvips?(8, 13)

class DiscourseVipsWorker
  class InvalidImage < StandardError
  end

  LINUX_PLATFORM = RUBY_PLATFORM.include?("linux")
  private_constant :LINUX_PLATFORM

  class Operations
    DEFAULT_READ_PATHS = %w[/bin /lib /lib64 /usr].freeze
    private_constant :DEFAULT_READ_PATHS

    # Dynamically loaded libvips modules use this cache to locate their shared libraries.
    DYNAMIC_LINKER_CACHE_PATH = "/etc/ld.so.cache"
    private_constant :DYNAMIC_LINKER_CACHE_PATH

    WARM_OPERATIONS = %w[text gravity flatten pngsave thumbnail].freeze
    private_constant :WARM_OPERATIONS

    def self.warm
      WARM_OPERATIONS.each do |name|
        operation = Vips.vips_operation_new(name)
        raise "unable to initialize libvips operation #{name}" if operation.null?

        GObject.g_object_unref(operation)
      end
    end

    def self.build(command)
      operation, *arguments = command

      case operation
      when "version"
        version
      when "letter-avatar"
        letter_avatar(*arguments)
      when "crop"
        crop(
          input_path: arguments[0],
          output_path: arguments[1],
          input_format: arguments[2],
          output_format: arguments[3],
          width: arguments[4],
          height: arguments[5],
          quality: arguments[6],
          strip_metadata: arguments[7],
        )
      when "dominant-color"
        dominant_color(*arguments)
      else
        raise ArgumentError, "unsupported libvips operation"
      end
    end

    def initialize(read_paths: [], write_paths: [], &action)
      @read_paths = read_paths
      @write_paths = write_paths
      @action = action
    end

    def call
      @action.call
    end

    def sandbox_paths(scratch:)
      {
        "read" => existing_paths([*DEFAULT_READ_PATHS, DYNAMIC_LINKER_CACHE_PATH, *@read_paths]),
        "write" => existing_paths([scratch, *@write_paths]),
      }
    end

    def self.version
      new { Vips.version_string }
    end
    private_class_method :version

    def self.letter_avatar(letter, output_path, background_color, font, font_path)
      new(
        read_paths: ["/etc/fonts", "/var/cache/fontconfig", font_path],
        write_paths: [File.dirname(output_path)],
      ) do
        if !letter || !output_path || !font_path
          raise ArgumentError, "invalid letter avatar arguments"
        end
        raise ArgumentError, "font file does not exist" if !File.file?(font_path)
        raise ArgumentError, "invalid background color" if !background_color.match?(/\A\h{6}\z/)

        background = background_color.scan(/\h{2}/).map { |channel| Integer(channel, 16) }

        block_loaders
        markup = %(<span foreground="#ffffff" alpha="80%">#{letter}</span>)
        text = Vips::Image.text(markup, font:, dpi: 72, fontfile: font_path, rgba: true)
        canvas =
          text.gravity(:centre, 360, 360, extend: :background, background: [*background, 255])
        canvas.flatten(background:).pngsave(output_path, compression: 6)
        nil
      end
    end
    private_class_method :letter_avatar

    def self.dominant_color(input_path)
      new(read_paths: [input_path]) do
        raise ArgumentError, "invalid dominant color arguments" if !input_path

        block_loaders(
          allowed: %w[
            VipsForeignLoadJpeg
            VipsForeignLoadPng
            VipsForeignLoadNsgif
            VipsForeignLoadWebp
            VipsForeignLoadHeif
            VipsForeignLoadJxl
          ],
        )
        components =
          begin
            image = Vips::Image.new_from_file(input_path, access: :sequential)
            if image.has_alpha?
              alpha_weighted_components(image)
            elsif %i[float double].include?(image.format)
              normalize_color(image)
                .thumbnail_image(1, height: 1, size: :force)
                .getpoint(0, 0)
                .first(3)
                .map(&:round)
            else
              thumbnail = Vips::Image.thumbnail(input_path, 1, height: 1, size: :force)
              normalize_color(thumbnail).getpoint(0, 0).first(3).map(&:round)
            end
          rescue Vips::Error => error
            raise InvalidImage, error.message
          end
        format("%02X%02X%02X", *components)
      end
    end
    private_class_method :dominant_color

    def self.crop(
      input_path:,
      output_path:,
      input_format:,
      output_format:,
      width:,
      height:,
      quality:,
      strip_metadata:
    )
      require "discourse_vips/ico_image" if input_format == "ico"

      read_paths = [input_path]
      read_paths.concat(%w[/etc/fonts /var/cache/fontconfig]) if input_format == "svg"

      new(read_paths:, write_paths: [File.dirname(output_path)]) do
        begin
          if File.identical?(input_path, output_path)
            raise ArgumentError, "input and output must be different files"
          end

          if !%w[true false].include?(strip_metadata)
            raise ArgumentError, "invalid metadata stripping flag"
          end
          strip_metadata = strip_metadata == "true"

          width = Integer(width, exception: false)
          height = Integer(height, exception: false)
          raise ArgumentError, "invalid crop dimensions" if !width&.positive? || !height&.positive?
          quality = Integer(quality, exception: false)
          if %w[jpg jpeg webp avif].include?(output_format) && !quality&.between?(1, 100)
            raise ArgumentError, "encoder quality is required"
          end

          block_loaders(
            allowed: %w[
              VipsForeignLoadJpeg
              VipsForeignLoadPng
              VipsForeignLoadNsgif
              VipsForeignLoadWebp
              VipsForeignLoadHeif
              VipsForeignLoadSvg
            ],
          )
          image = load_downsize_image(input_path:, input_format:).autorot
          scale = [width.to_f / image.width, height.to_f / image.height].max
          resized_width = [(image.width * scale).round, width].max
          resized_height = [(image.height * scale).round, height].max
          if strip_metadata
            if %i[rgb16 grey16].include?(image.interpretation)
              image = image.colourspace(image.interpretation == :grey16 ? :b_w : :srgb)
            end
            image =
              resize_thumbnail_image(
                image:,
                width: resized_width,
                height: resized_height,
                output_format:,
              )
          else
            image =
              resize_downsize_image(
                image:,
                width: resized_width,
                height: resized_height,
                input_format:,
                output_format:,
              )
          end
          image = image.crop((image.width - width) / 2, 0, width, height)
          image = sharpen_resized_image(image:, output_format:)
          save_downsize_image(
            image:,
            input_path:,
            output_path:,
            output_format:,
            quality:,
            strip_metadata:,
          )
        rescue Vips::Error, ArgumentError, Nokogiri::XML::SyntaxError => error
          raise InvalidImage, error.message
        end
        nil
      end
    end
    private_class_method :crop

    def self.load_svg(input_path)
      Vips::Image.svgload(input_path, dpi: 96, scale: 0.75)
    rescue Vips::Error => error
      document = Nokogiri.XML(File.read(input_path)) { |config| config.strict.nonet }
      root = document.root
      raise error if root&.name != "svg" || !root["viewBox"]

      viewbox = root["viewBox"].strip.split(/[\s,]+/).map { |value| Float(value, exception: false) }
      if viewbox.length != 4 || !viewbox.all? { |value| value&.finite? } || !viewbox[2].positive? ||
           !viewbox[3].positive?
        raise error
      end

      zero_dimensions =
        %w[width height].filter do |dimension|
          root[dimension]&.strip&.match?(
            /\A[+-]?(?:0+(?:\.0*)?|\.0+)(?:e[+-]?\d+)?(?:px|in|cm|mm|pt|pc|em|ex|%)?\z/i,
          )
        end
      raise error if zero_dimensions.empty?

      zero_dimensions.each do |dimension|
        root[dimension] = viewbox[dimension == "width" ? 2 : 3].to_s
      end
      Vips::Image.svgload_buffer(document.to_xml, dpi: 96, scale: 0.75)
    end
    private_class_method :load_svg

    def self.load_image_for_orientation(input_path:, loader:, **options)
      image = Vips::Image.public_send(loader, input_path, access: :sequential, **options)
      if image.get_typeof("orientation") != 0 && image.get("orientation") > 2
        image = Vips::Image.public_send(loader, input_path, access: :random, **options)
      end
      image
    end
    private_class_method :load_image_for_orientation

    def self.load_downsize_image(input_path:, input_format:)
      case input_format
      when "jpg", "jpeg"
        load_image_for_orientation(input_path:, loader: :jpegload)
      when "png"
        load_image_for_orientation(input_path:, loader: :pngload)
      when "gif"
        image = Vips::Image.gifload(input_path, page: 0, n: 1, access: :sequential)
        profile = gif_icc_profile(input_path)
        image.set_type(Vips::BLOB_TYPE, "icc-profile-data", profile) if profile
        image
      when "webp"
        load_image_for_orientation(input_path:, loader: :webpload, page: 0, n: 1)
      when "avif"
        load_image_for_orientation(input_path:, loader: :heifload, page: 0, n: 1)
      when "svg"
        load_svg(input_path).flatten(background: [255, 255, 255])
      when "ico"
        DiscourseVips::IcoImage.load(input_path:, page: 0)
      else
        raise ArgumentError, "unsupported input format"
      end
    end
    private_class_method :load_downsize_image

    def self.resample_image(image:, width:, height:, kernel:)
      if width < image.width || height < image.height
        image =
          image.resize(
            [width.to_f / image.width, 1.0].min,
            vscale: [height.to_f / image.height, 1.0].min,
            kernel:,
          )
      end
      return image if width == image.width && height == image.height

      image.affine(
        [width.to_f / image.width, 0, 0, height.to_f / image.height],
        interpolate: Vips::Interpolate.new("bicubic"),
        idx: 0.5,
        idy: 0.5,
        odx: -0.5,
        ody: -0.5,
        oarea: [0, 0, width, height],
        extend: :copy,
        premultiplied: true,
      )
    end
    private_class_method :resample_image

    def self.resize_downsize_image(image:, width:, height:, input_format:, output_format:)
      return image if width == image.width && height == image.height

      palette = image.get_typeof("palette-bit-depth") != 0 || input_format == "gif"
      kernel =
        (
          if image.has_alpha? || palette || width > image.width || height > image.height
            :mitchell
          else
            :lanczos3
          end
        )
      alpha = image.has_alpha?
      pixel_format = image.format
      image = image.cast(:float) if pixel_format == :ushort
      image = image.premultiply if alpha
      image = resample_image(image:, width:, height:, kernel:)
      image = image.unpremultiply if alpha
      if (alpha || pixel_format == :ushort) && output_format != "gif"
        image = image.round(:rint).cast(pixel_format)
      end
      image
    end
    private_class_method :resize_downsize_image

    def self.jpeg_subsample_mode(image:, input_path:)
      return :auto if image.get_typeof("jpeg-chroma-subsample") == 0

      case image.get("jpeg-chroma-subsample")
      when "4:4:4"
        :off
      when "4:2:0"
        jpeg_sampling_factors(input_path) == [[2, 2], [1, 1], [1, 1]] ? :on : :off
      else
        :auto
      end
    end
    private_class_method :jpeg_subsample_mode

    def self.jpeg_sampling_factors(input_path)
      File.open(input_path, "rb") do |file|
        raise InvalidImage, "invalid JPEG signature" unless file.read(2) == "\xFF\xD8".b

        loop do
          raise InvalidImage, "invalid JPEG marker" unless file.getbyte == 0xFF
          marker = file.getbyte
          marker = file.getbyte while marker == 0xFF
          if !marker || marker == 0 || marker == 0xDA || marker == 0xD9
            raise InvalidImage, "JPEG frame header missing"
          end
          next if marker == 0x01

          length_bytes = file.read(2)
          raise InvalidImage, "truncated JPEG segment" unless length_bytes&.bytesize == 2
          length = length_bytes.unpack1("n")
          if length < 2 || length - 2 > file.size - file.pos
            raise InvalidImage, "invalid JPEG segment length"
          end

          if (0xC0..0xCF).cover?(marker) && ![0xC4, 0xC8, 0xCC].include?(marker)
            raise InvalidImage, "invalid JPEG frame header" if length < 8
            header = file.read(6)
            components = header.getbyte(5)
            if components == 0 || length != 8 + 3 * components
              raise InvalidImage, "invalid JPEG frame components"
            end
            return(
              Array.new(components) do
                component = file.read(3)
                sampling = component.getbyte(1)
                horizontal = sampling >> 4
                vertical = sampling & 0x0F
                unless (1..4).cover?(horizontal) && (1..4).cover?(vertical)
                  raise InvalidImage, "invalid JPEG sampling factors"
                end
                [horizontal, vertical]
              end
            )
          end

          file.seek(length - 2, IO::SEEK_CUR)
        end
      end
    end
    private_class_method :jpeg_sampling_factors

    def self.save_downsize_image(
      image:,
      input_path:,
      output_path:,
      output_format:,
      quality:,
      strip_metadata: false
    )
      metadata_options = strip_metadata ? { keep: :icc } : {}
      case output_format
      when "jpg", "jpeg"
        image = image.extract_band(0, n: image.bands - 1) if image.has_alpha?
        image.jpegsave(
          output_path,
          Q: quality,
          interlace: false,
          subsample_mode: jpeg_subsample_mode(image:, input_path:),
          **metadata_options,
        )
      when "png"
        image.pngsave(output_path, interlace: false, **metadata_options)
      when "gif"
        if image.has_alpha?
          max_alpha = %i[rgb16 grey16].include?(image.interpretation) ? 65_535 : 255
          alpha = image[image.bands - 1] > max_alpha / 2.0
          image =
            image
              .extract_band(0, n: image.bands - 1)
              .colourspace(:srgb)
              .round(:rint)
              .cast(:uchar)
              .bandjoin(alpha)
        end
        if image.get_typeof("icc-profile-data") == 0
          image.gifsave(output_path, bitdepth: 8, interlace: false, **metadata_options)
        else
          contents = image.gifsave_buffer(bitdepth: 8, interlace: false, **metadata_options)
          packed = contents.getbyte(10)
          header_length = 13 + (packed.anybits?(0x80) ? 3 * 2**((packed & 7) + 1) : 0)
          profile = image.get("icc-profile-data")
          File.open(output_path, "wb") do |file|
            file.write(contents.byteslice(0, header_length))
            file.write("\x21\xFF\x0BICCRGBG1012".b)
            offset = 0
            while offset < profile.bytesize
              block = profile.byteslice(offset, 255)
              file.write([block.bytesize].pack("C"))
              file.write(block)
              offset += block.bytesize
            end
            file.write("\0".b)
            file.write(contents.byteslice(header_length..))
          end
        end
      when "webp"
        image.webpsave(
          output_path,
          Q: quality,
          lossless: quality == 100,
          effort: 4,
          **metadata_options,
        )
      when "avif"
        image.heifsave(
          output_path,
          compression: :av1,
          Q: quality,
          lossless: quality == 100,
          effort: 3,
          subsample_mode: :on,
          **metadata_options,
        )
      when "ico"
        image = image.colourspace(:srgb).cast(:uchar, shift: true)
        payload = image.pngsave_buffer(strip: true)
        header = [0, 1, 1].pack("v3")
        entry = [image.width % 256, image.height % 256, 0, 0, 1, 32, payload.bytesize, 22].pack(
          "C4v2V2",
        )
        File.binwrite(output_path, header + entry + payload)
      else
        raise ArgumentError, "unsupported output format"
      end
    end
    private_class_method :save_downsize_image

    def self.gif_icc_profile(input_path)
      File.open(input_path, "rb") do |file|
        header = read_gif_bytes(file: file, length: 13)
        raise InvalidImage, "invalid GIF header" unless header.start_with?("GIF87a", "GIF89a")
        packed = header.getbyte(10)
        read_gif_bytes(file: file, length: 3 * (2 << (packed & 7))) if packed & 128 != 0
        profile = nil

        loop do
          case file.getbyte
          when 0x3b
            return profile
          when 0x21
            label = file.getbyte
            if label == 0xff
              length = file.getbyte
              raise InvalidImage, "truncated GIF extension" unless length
              identifier = read_gif_bytes(file: file, length: length)
              data = gif_subblocks(file: file, collect: identifier == "ICCRGBG1012")
              profile = data if identifier == "ICCRGBG1012"
            else
              gif_subblocks(file: file, collect: false)
            end
          when 0x2c
            descriptor = read_gif_bytes(file: file, length: 9)
            packed = descriptor.getbyte(8)
            read_gif_bytes(file: file, length: 3 * (2 << (packed & 7))) if packed & 128 != 0
            read_gif_bytes(file: file, length: 1)
            gif_subblocks(file: file, collect: false)
          else
            raise InvalidImage, "invalid GIF block"
          end
        end
      end
    end
    private_class_method :gif_icc_profile

    def self.gif_subblocks(file:, collect:)
      data = +"".b if collect
      loop do
        length = file.getbyte
        raise InvalidImage, "truncated GIF subblock" unless length
        return data if length.zero?
        block = read_gif_bytes(file: file, length: length)
        data << block if collect
      end
    end
    private_class_method :gif_subblocks

    def self.read_gif_bytes(file:, length:)
      bytes = file.read(length)
      raise InvalidImage, "truncated GIF data" unless bytes&.bytesize == length
      bytes
    end
    private_class_method :read_gif_bytes

    def self.resize_thumbnail_image(image:, width:, height:, output_format:)
      return image if width == image.width && height == image.height

      pixel_format = image.format
      alpha = image.has_alpha?
      image = image.cast(:float) if pixel_format == :ushort
      image = image.premultiply if alpha
      image = resample_image(image:, width:, height:, kernel: :lanczos3)
      image = image.unpremultiply if alpha
      if (alpha || pixel_format == :ushort) && output_format != "gif"
        image = image.round(:rint).cast(pixel_format)
      end
      image
    end
    private_class_method :resize_thumbnail_image

    def self.sharpen_resized_image(image:, output_format:)
      blurred = image.has_alpha? ? image.premultiply : image
      mask = Vips::Image.gaussmat(0.5, 0.0001, separable: true, precision: :float)
      blurred = blurred.convsep(mask, precision: :float)
      blurred = blurred.unpremultiply if image.has_alpha?
      sharpened = image + (image - blurred) * 0.7
      output_format == "gif" ? sharpened : sharpened.round(:rint).cast(image.format)
    end
    private_class_method :sharpen_resized_image

    def self.normalize_color(image)
      image = image.colourspace(:srgb)
      image = (image * 255).round(:rint) if %i[float double].include?(image.format)
      image.cast(:uchar, shift: true)
    end
    private_class_method :normalize_color

    def self.alpha_weighted_components(image)
      alpha = image[image.bands - 1]
      colors = normalize_color(image.extract_band(0, n: image.bands - 1))
      weighted_colors = colors * alpha
      statistics = alpha.bandjoin(weighted_colors).stats
      alpha_sum = statistics.getpoint(2, 1).first
      return 0, 0, 0 if alpha_sum.zero?

      3.times.map { |band| (statistics.getpoint(2, band + 2).first / alpha_sum).round }
    end
    private_class_method :alpha_weighted_components

    def self.block_loaders(allowed: [])
      Vips.block_untrusted(true)
      Vips.block("VipsForeignLoad", true)
      allowed.each { |loader| Vips.block(loader, false) }
    end
    private_class_method :block_loaders

    private

    def existing_paths(paths)
      paths
        .filter { |path| path.to_s != "" && File.exist?(path) }
        .map { |path| File.expand_path(path) }
        .uniq
    end
  end

  RLIMITS = {
    cpu_seconds: 300,
    memory_bytes: 4 * 1024 * 1024 * 1024,
    file_size_bytes: 10 * 1024 * 1024 * 1024,
    open_files: 1024,
  }.freeze
  private_constant :RLIMITS

  def self.run(server_fd:, owner_fd:)
    parent_pid = Process.ppid
    Landlock::Native.set_parent_death_signal! if LINUX_PLATFORM
    exit! 1 if Process.ppid != parent_pid

    Process.setproctitle("discourse vips worker")
    new(server: UNIXServer.for_fd(server_fd), owner_reader: IO.for_fd(owner_fd)).run
  end

  def initialize(server:, owner_reader:)
    @server = server
    @socket_path = server.local_address.unix_path
    @socket_identity = File.stat(@socket_path).then { |stat| [stat.dev, stat.ino] }
    @owner_reader = owner_reader
  end

  def run
    Signal.trap("CHLD") { reap_connection_processes }
    Operations.warm

    loop do
      ready_ios = IO.select([@server, @owner_reader]).first
      break if ready_ios.include?(@owner_reader)

      connection = @server.accept
      fork_connection_process(connection)
    end
  ensure
    @server.close unless @server.closed?
    @owner_reader.close unless @owner_reader.closed?
    remove_socket_directory
    Process.kill("KILL", -Process.pid)
  end

  private

  def fork_connection_process(connection)
    parent_pid = Process.pid
    fork do
      Landlock::Native.set_parent_death_signal! if LINUX_PLATFORM
      exit! 1 if Process.ppid != parent_pid
      Signal.trap("CHLD", "DEFAULT")
      @server.close
      @owner_reader.close
      handle_connection(connection)
      exit! 0
    end

    connection.close
  end

  def reap_connection_processes
    while Process.waitpid(-1, Process::WNOHANG)
    end
  rescue Errno::ECHILD
  end

  def handle_connection(connection)
    request = MessagePack.unpack(connection.read)
    operation = Operations.build(request.fetch("command"))
    response = run_sandboxed(request:, operation:)
    write_response(connection, response)
  rescue StandardError => error
    write_response(connection, "status" => "error", "message" => error.message.byteslice(0, 4096))
  ensure
    connection.close unless connection.closed?
  end

  def write_response(connection, response)
    connection.write(MessagePack.pack(response))
  rescue IOError, SystemCallError
  end

  def run_sandboxed(request:, operation:)
    Dir.mktmpdir("discourse-vips-") do |scratch|
      sandbox_paths = operation.sandbox_paths(scratch:)
      result =
        Landlock.fork(
          read: sandbox_paths.fetch("read"),
          write: sandbox_paths.fetch("write"),
          execute: [],
          timeout: Float(request.fetch("timeout")),
          env: child_environment(scratch),
          unsetenv_others: true,
          rlimits: RLIMITS,
          seccomp_deny_network: LINUX_PLATFORM,
          on_unsupported: :run_without_landlock,
        ) do |stdout, _stderr|
          apply_nice(request)
          stdout.write(MessagePack.pack(operation_response(operation)))
        end

      if result.timed_out?
        { "status" => "timeout" }
      elsif result.success?
        MessagePack.unpack(result.stdout)
      else
        { "status" => "error", "message" => "libvips operation failed" }
      end
    end
  end

  def remove_socket_directory
    stat = File.stat(@socket_path)
    return if [stat.dev, stat.ino] != @socket_identity

    File.unlink(@socket_path)
    Dir.rmdir(File.dirname(@socket_path))
  rescue SystemCallError
  end

  def child_environment(scratch)
    {
      "HOME" => scratch,
      "TMPDIR" => scratch,
      "XDG_CACHE_HOME" => scratch,
      "MALLOC_ARENA_MAX" => "2",
    }
  end

  def apply_nice(request)
    Process.setpriority(Process::PRIO_PROCESS, 0, Integer(request.fetch("nice"))) if request["nice"]
  end

  def operation_response(operation)
    value = operation.call
    { "status" => "ok", "value" => value }
  rescue InvalidImage => error
    { "status" => "invalid_image", "message" => error.message.byteslice(0, 4096) }
  rescue StandardError => error
    { "status" => "error", "message" => error.message.byteslice(0, 4096) }
  end
end

if $PROGRAM_NAME == __FILE__
  server_fd, owner_fd = ARGV.map { |argument| Integer(argument) }
  DiscourseVipsWorker.run(server_fd:, owner_fd:)
end
